---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import JournalGrid from "../components/JournalGrid.astro";
import { journalEntries } from "../data/journalEntries";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Expertise", href: "/expertise" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Journal — Don De Castro"
  description="Notes and experiments on rigging, motion pipelines, and technical art."
>
  <div class="journal-root relative z-10">
    <SiteHeader navItems={navItems} sticky>
      <span slot="middle" class="journal-label">Journal</span>
    </SiteHeader>

    <main class="page-container journal-main">
      <div class="sub-bar">
        <span>Journal / Entries 001–{String(journalEntries.length).padStart(3, "0")}</span>
        <span class="hover-hint">Hover for color</span>
      </div>
      <JournalGrid entries={journalEntries} />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* The site-wide fixed frame overlaps a long scrolling archive — hide on this page. */
  body:has(.journal-root) .frame {
    display: none;
  }
</style>

<style>
  .journal-root {
    min-height: 100vh;
  }

  .journal-label {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: var(--leading-title);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .journal-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-3) var(--space-12);
  }

  .sub-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    font-weight: 700;
    letter-spacing: var(--tracking-mini);
    text-transform: uppercase;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: none) {
    .hover-hint {
      display: none;
    }
  }

  /* Phone: the sub-bar already names the page; the header has no room. */
  @media (max-width: 767px) {
    .journal-label {
      display: none;
    }
  }
</style>
