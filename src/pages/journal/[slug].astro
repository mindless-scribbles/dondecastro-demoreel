---
import JournalEntryLayout from "../../layouts/JournalEntryLayout.astro";
import { journalEntries, type JournalEntry } from "../../data/journalEntries";

export async function getStaticPaths() {
  return journalEntries
    .filter((e) => e.hasPage)
    .map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;

const built = journalEntries.filter((e) => e.hasPage);
const currentIdx = built.findIndex((e) => e.slug === entry.slug);
const nextEntry = built[(currentIdx + 1) % built.length];
const nextNumber = nextEntry.id.replace(/\[|\]/g, "");
---

<JournalEntryLayout
  title={`${entry.title} — Field Logs`}
  description={entry.subtitle ?? entry.title}
  currentSlug={entry.slug}
>
  <header class="hero">
    <img
      src={entry.heroImage ?? entry.image}
      alt={entry.title}
      class="hero-image"
    />
    <div class="hero-overlay">
      <h1 class="headline">
        {entry.title}{entry.subtitle && <>: <em>{entry.subtitle}</em></>}
      </h1>
    </div>
  </header>

  <article class="page-container article-container">
    <div class="article-meta">
      <span>Year: <b>{entry.year}</b></span>
      <span>Format: <b>{entry.format}</b></span>
      <span>Category: <b>{entry.category}</b></span>
      <span>Ref: <b>{entry.id}</b></span>
    </div>

    <section class="content-body">
      {
        entry.article?.map((block) => {
          if (block.type === "p") {
            if (block.dropcap) {
              const firstChar = block.html.charAt(0);
              const rest = block.html.slice(1);
              return (
                <p>
                  <span class="dropcap">{firstChar}</span>
                  <Fragment set:html={rest} />
                </p>
              );
            }
            return (
              <p>
                <Fragment set:html={block.html} />
              </p>
            );
          }
          if (block.type === "quote") {
            return <div class="quote-block">{block.text}</div>;
          }
          if (block.type === "video") {
            return (
              <figure class="article-video">
                <div class="video-frame">
                  <iframe
                    src={`https://www.youtube.com/embed/${block.videoId}`}
                    title={block.title ?? "Embedded video"}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  />
                </div>
                {block.caption && <figcaption class="caption">{block.caption}</figcaption>}
              </figure>
            );
          }
          return (
            <>
              <img src={block.src} alt={block.alt} class="sub-image" />
              <div class="caption">{block.caption}</div>
            </>
          );
        })
      }
    </section>
  </article>

  <footer class="page-container entry-footer">
    <div>© 2026 DON DE CASTRO — FIELD LOGS</div>
    <a class="proceed" href={`/journal/${nextEntry.slug}`}>
      PROCEED TO PROJECT [{nextNumber}] →
    </a>
  </footer>
</JournalEntryLayout>

<style>
  .hero {
    width: 100%;
    height: 55vh;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  /* Grayscale hero is a deliberate editorial exception (STYLE_GUIDE §3). */
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    opacity: 0.7;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: var(--space-4) var(--page-margin);
    background: linear-gradient(to top, var(--color-bg), transparent);
  }

  .headline {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    line-height: 1;
    font-weight: 600;
    max-width: 896px;
    margin: 0 auto;
    text-align: center;
    color: var(--color-text);
  }

  .headline em {
    font-style: italic;
    font-weight: 400;
  }

  /* 720px reading column inside the page margin. */
  .article-container,
  .entry-footer {
    max-width: calc(720px + 2 * var(--page-margin));
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) 0;
    text-align: center;
  }

  .article-meta b {
    color: var(--color-text);
    font-weight: 700;
  }

  .quote-block {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-style: italic;
    font-weight: 400;
    line-height: var(--leading-title);
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-3);
    margin: var(--space-6) 0;
    color: var(--color-text);
  }

  .sub-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: block;
  }

  .article-video {
    margin: 0 0 var(--space-6);
  }

  .article-video .caption {
    margin-bottom: 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .caption {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
    text-transform: uppercase;
  }

  .entry-footer {
    padding-block: var(--space-12) var(--space-8);
    text-align: center;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-mini);
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .proceed {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    margin-top: var(--space-2);
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: var(--tracking-mini);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .proceed:hover {
      border-bottom-color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proceed {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .hero {
      height: 70vh;
    }

    .hero-overlay {
      padding-block: var(--space-8);
    }

    .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }

    .quote-block {
      font-size: var(--text-heading);
      line-height: var(--leading-heading);
      padding-left: var(--space-4);
      margin-block: var(--space-8);
    }
  }
</style>
