---
import { Image } from "astro:assets";
import { render } from "astro:content";
import JournalEntryLayout from "../../layouts/JournalEntryLayout.astro";
import { getJournal, type JournalItem } from "../../lib/journal";

export async function getStaticPaths() {
  const entries = await getJournal();
  // Newest first; "proceed" goes to the next older entry and wraps to the newest.
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}

interface Props {
  entry: JournalItem;
  next: JournalItem;
}

const { entry, next } = Astro.props;
const { data } = entry.entry;
const { Content } = await render(entry.entry);
const nextNumber = next.id.replace(/\[|\]/g, "");
---

<JournalEntryLayout
  title={`${entry.title} — Field Logs`}
  description={entry.subtitle ?? entry.title}
  currentSlug={entry.slug}
>
  <header class="hero">
    <img src={entry.thumb} alt="" class="hero-image" />
    <div class="hero-overlay">
      <h1 class="headline">
        {entry.title}{entry.subtitle && <>: <em>{entry.subtitle}</em></>}
      </h1>
    </div>
  </header>

  <article class="page-container article-container">
    <div class="article-meta">
      <span>Year: <b>{entry.date.getUTCFullYear()}</b></span>
      <span>Format: <b>{data.format}</b></span>
      <span>Category: <b>{data.category}</b></span>
      <span>Ref: <b>{entry.id}</b></span>
    </div>

    <section class="content-body">
      {
        data.youtube && (
          <figure class="article-video">
            <div class="video-frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${data.youtube}`}
                title={`${entry.title} video`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
            {data.source && (
              <figcaption class="caption">
                <a href={data.source.url} target="_blank" rel="noopener noreferrer">
                  Watch on {data.source.platform === "youtube" ? "YouTube" : "Instagram"}
                </a>
              </figcaption>
            )}
          </figure>
        )
      }
      {
        data.images.map((img) => (
          <Image src={img.src} alt={img.alt} widths={[720, 1440]} sizes="(min-width: 768px) 720px, 100vw" class="photo" />
        ))
      }
      {
        !data.youtube && data.source && (
          <div class="caption">
            <a href={data.source.url} target="_blank" rel="noopener noreferrer">
              View on {data.source.platform === "youtube" ? "YouTube" : "Instagram"}
            </a>
          </div>
        )
      }
      <Content />
    </section>
  </article>

  <footer class="page-container entry-footer">
    <div>© 2026 DON DE CASTRO — FIELD LOGS</div>
    <a class="proceed" href={`/journal/${next.slug}`}>
      PROCEED TO PROJECT [{nextNumber}] →
    </a>
  </footer>
</JournalEntryLayout>

<style>
  .hero {
    width: 100%;
    height: 55vh;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  /* Grayscale hero is a deliberate editorial exception (STYLE_GUIDE §3). */
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    opacity: 0.7;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: var(--space-4) var(--page-margin);
    background: linear-gradient(to top, var(--color-bg), transparent);
  }

  .headline {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    line-height: 1;
    font-weight: 600;
    max-width: 896px;
    margin: 0 auto;
    text-align: center;
    color: var(--color-text);
  }

  .headline em {
    font-style: italic;
    font-weight: 400;
  }

  /* 720px reading column inside the page margin. */
  .article-container,
  .entry-footer {
    max-width: calc(720px + 2 * var(--page-margin));
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) 0;
    text-align: center;
  }

  .article-meta b {
    color: var(--color-text);
    font-weight: 700;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .caption a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .caption a:hover {
      color: rgba(255, 51, 0, 0.55);
    }
  }

  .article-video {
    margin: 0 0 var(--space-6);
  }

  .article-video .caption {
    margin-bottom: 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .caption {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
    text-transform: uppercase;
  }

  .entry-footer {
    padding-block: var(--space-12) var(--space-8);
    text-align: center;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-mini);
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .proceed {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    margin-top: var(--space-2);
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: var(--tracking-mini);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .proceed:hover {
      border-bottom-color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proceed {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .hero {
      height: 70vh;
    }

    .hero-overlay {
      padding-block: var(--space-8);
    }

    .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }

  }
</style>
