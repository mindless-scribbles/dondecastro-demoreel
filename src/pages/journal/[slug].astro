---
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import JournalEntryLayout from "../../layouts/JournalEntryLayout.astro";
import { formatDate, getJournal, type JournalItem } from "../../lib/journal";

export async function getStaticPaths() {
  const entries = await getJournal();
  // Newest first: the older entry is the next item, the newer one the previous. No wrap-around.
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, older: entries[i + 1], newer: entries[i - 1] },
  }));
}

interface Props {
  entry: JournalItem;
  older?: JournalItem;
  newer?: JournalItem;
}

const { entry, older, newer } = Astro.props;
const { data } = entry.entry;
const { Content } = await render(entry.entry);
const date = formatDate(entry.date);
const isoDate = entry.date.toISOString().slice(0, 10);
const platform = data.source?.platform === "instagram" ? "Instagram" : "YouTube";
const clips = await Promise.all(
  entry.videos.map(async (v) => ({
    url: v.url,
    poster: v.poster ? (await getImage({ src: v.poster, width: 1280, format: "webp" })).src : undefined,
    width: v.poster?.width,
    height: v.poster?.height,
  })),
);
---

<JournalEntryLayout title={`${entry.title} — Don De Castro`} description={entry.subtitle ?? entry.title}>
  <article class:list={["page-container entry", data.youtube ? "entry-article" : "entry-media"]}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/journal">Journal</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.id}</span>
    </nav>

    {
      data.youtube ? (
        <>
          <header class="article-head">
            <h1 class="title">{entry.title}</h1>
            {entry.subtitle && <p class="subtitle">{entry.subtitle}</p>}
            <dl class="meta">
              <div>
                <dt>Date</dt>
                <dd>
                  <time datetime={isoDate}>{date}</time>
                </dd>
              </div>
              <div>
                <dt>Format</dt>
                <dd>{data.format}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd>{data.category}</dd>
              </div>
              <div>
                <dt>Ref</dt>
                <dd>{entry.id}</dd>
              </div>
            </dl>
          </header>

          <div class="frame frame-video">
            {/* Facade: the thumbnail links to YouTube; the script swaps in the player on click. */}
            <a
              class="facade"
              href={`https://www.youtube.com/watch?v=${data.youtube}`}
              data-video-id={data.youtube}
              data-title={entry.title}
              aria-label={`Play video: ${entry.title}`}
            >
              <img src={entry.thumb} alt="" />
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </a>
          </div>

          <div class="article-main">
            <div class="prose article-body">
              <Content />
            </div>

            {data.source && (
              <a class="source-btn" href={data.source.url} target="_blank" rel="noopener noreferrer">
                Watch on {platform} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </>
      ) : (
        <div class="media-grid">
          <div class="media-col">
            {clips.map((clip) => (
              <div class="frame frame-clip">
                <video
                  class="clip"
                  src={clip.url}
                  poster={clip.poster}
                  width={clip.width}
                  height={clip.height}
                  controls
                  playsinline
                  preload="metadata"
                />
              </div>
            ))}
            {data.images.map((img) => (
              <div class="frame">
                <Image
                  src={img.src}
                  alt={img.alt}
                  widths={[640, 960, 1280, 1800]}
                  sizes="(min-width: 1440px) 900px, (min-width: 1024px) 64vw, 100vw"
                  class="photo"
                />
              </div>
            ))}
          </div>

          <div class="text-col">
            <div class="chips">
              <span class="chip">{data.category}</span>
              <span class="chip">{data.format}</span>
            </div>
            {/* Untitled posts: the caption stands alone; the heading is for screen readers. */}
            <h1 class:list={["title", { "visually-hidden": entry.untitled }]}>{entry.title}</h1>
            <time class="date" datetime={isoDate}>
              {date}
            </time>
            <div class="prose caption">
              <Content />
            </div>
            {data.source && (
              <a class="source-btn" href={data.source.url} target="_blank" rel="noopener noreferrer">
                View on {platform} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      )
    }
  </article>

  <nav class="page-container pager" aria-label="More journal entries">
    {
      older ? (
        <a class="pager-card" href={`/journal/${older.slug}`}>
          <span class="pager-label">Previous · {older.id}</span>
          <span class="pager-title">{older.title}</span>
          <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </a>
      ) : (
        <div class="pager-card pager-end">
          <span class="pager-label">Previous</span>
          <span class="pager-title">This is the first entry</span>
        </div>
      )
    }
    {
      newer ? (
        <a class="pager-card pager-next" href={`/journal/${newer.slug}`}>
          <span class="pager-label">Next · {newer.id}</span>
          <span class="pager-title">{newer.title}</span>
          <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </a>
      ) : (
        <div class="pager-card pager-next pager-end">
          <span class="pager-label">Next</span>
          <span class="pager-title">This is the latest entry</span>
        </div>
      )
    }
  </nav>
</JournalEntryLayout>

<script>
  // YouTube facade: load the player only when asked. Modifier-clicks still open YouTube.
  document.querySelectorAll<HTMLAnchorElement>(".facade[data-video-id]").forEach((facade) => {
    facade.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.videoId}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = `${facade.dataset.title ?? ""} video`;
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .entry {
    padding-block: var(--space-4) var(--space-8);
  }

  /* ---------- Shared ---------- */
  .crumb {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .crumb a {
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .crumb a:hover {
      color: var(--color-hover);
    }
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  /* Home-card frame: the media sits inside with a smaller radius. */
  .frame {
    padding: var(--space-1);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .source-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    align-self: flex-start;
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  @media (hover: hover) {
    .source-btn:hover {
      background: var(--color-surface-raised);
      border-color: var(--color-text);
    }
  }

  /* ---------- Media layout: photo and reel posts ---------- */
  .media-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .media-col {
    display: flex;
    flex-direction: column;
    gap: var(--gutter);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* Reels keep their own shape, capped so a vertical clip doesn't fill the screen. */
  .frame-clip {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .clip {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    background: #000;
    border-radius: var(--radius-md);
  }

  .text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-half);
  }

  .chip {
    padding: var(--space-half) var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #a1a1aa;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .caption {
    margin-top: var(--space-1);
  }

  /* ---------- Article layout: YouTube posts ---------- */
  /* Header and video span the page; only the body is a centered 720px column. */
  .entry-article {
    display: flex;
    flex-direction: column;
  }

  .article-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-subtitle);
    line-height: var(--leading-subtitle);
    color: #a1a1aa;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .meta dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .entry-article .title {
    max-width: 1104px;
  }

  .frame-video {
    position: relative;
  }

  /* The iframe is created by the script, so it has no scope attribute. */
  .facade,
  .frame-video :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .facade {
    position: relative;
  }

  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    transform: translate(-50%, -50%);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: rgba(7, 7, 9, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .play svg {
    width: var(--space-4);
    height: var(--space-4);
    fill: currentColor;
  }

  @media (hover: hover) {
    .facade:hover .play {
      background: rgba(7, 7, 9, 0.8);
      border-color: var(--color-text);
    }
  }

  .article-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
    max-width: 720px;
    margin: var(--space-8) auto 0;
  }

  .article-body > :global(p:first-child) {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  /* ---------- Previous / next ---------- */
  .pager {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-12);
  }

  .pager-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    padding-right: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: var(--leading-title);
    text-wrap: balance;
  }

  .pager-end .pager-title {
    color: var(--color-muted);
  }

  .chevron {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    width: var(--space-3);
    height: var(--space-3);
    transform: translateY(-50%);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    color: var(--color-muted);
  }

  @media (hover: hover) {
    a.pager-card:hover {
      background: var(--color-surface-raised);
      border-color: var(--color-border-strong);
    }

    a.pager-card:hover .chevron {
      color: var(--color-text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crumb a,
    .source-btn,
    .play,
    .pager-card {
      transition: none;
    }
  }

  /* ---------- Breakpoints ---------- */
  @media (min-width: 768px) {
    .entry {
      padding-top: var(--space-6);
    }

    .title {
      font-size: 40px;
      line-height: var(--leading-heading);
    }

    .meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Previous: chevron on the left. Next: right-aligned, chevron on the right. */
    .pager-card:not(.pager-next) {
      padding-left: var(--space-8);
      padding-right: var(--space-3);
    }

    .pager-card:not(.pager-next) .chevron {
      right: auto;
      left: var(--space-3);
    }

    .pager-next {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .title {
      font-size: 48px;
      line-height: 56px;
    }

    /* Media across 8 of 12 columns, text in the other 4, pinned while photos scroll. */
    .media-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gutter);
      align-items: start;
    }

    .media-col {
      grid-column: span 8;
    }

    .text-col {
      grid-column: span 4;
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
    }
  }
</style>
