---
// Hero block shown on the homepage, under the reel panel. Static: title and tagline only.
---

<section class="hero">
  <h1 class="hero-title">Don De Castro</h1>
  <p class="tagline">
    Technical Animator &amp; Motion Edit Supervisor.<br />
    Feature film, AAA games, virtual production.
  </p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    /* Always one line: the name is ~13.9× its font size wide in Syne 800,
       so size from the available width (÷14.5 leaves slack), capped at the hero size. */
    font-size: min(var(--text-hero), calc((100vw - 2 * var(--page-margin)) / 14.5));
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
  }

  .tagline {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .tagline {
      font-size: var(--text-label);
    }
  }
</style>
