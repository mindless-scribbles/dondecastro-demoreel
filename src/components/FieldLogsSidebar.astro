---
import { getJournal } from "../lib/journal";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const entries = await getJournal();

const numberFor = (id: string) => id.replace(/\[|\]/g, "");
---

<aside class="field-logs">
  <div class="top">
    <div class="brand">FIELD LOGS</div>
    <ol class="index-list">
      {
        entries.map((e) => {
          const num = numberFor(e.id);

          if (e.slug === currentSlug) {
            return (
              <li class="index-item current" aria-current="page">
                <span class="num">{num}</span>
                <span class="title">{e.title}</span>
              </li>
            );
          }

          return (
            <li class="index-item">
              <a class="index-link" href={`/journal/${e.slug}`}>
                <span class="num">{num}</span>
                <span class="title">{e.title}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
  <div class="status-footer">SYS.ARCHIVE_VER_2.4 / 2026</div>
</aside>

<style>
  .field-logs {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) var(--page-margin) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 100%;
  }

  @media (min-width: 1024px) {
    .field-logs {
      position: sticky;
      top: var(--header-height);
      height: calc(100vh - var(--header-height));
      min-height: 0;
      overflow-y: auto;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
      padding: var(--space-5) var(--space-4);
    }
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: 800;
    letter-spacing: var(--tracking-label);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 1024px) {
    .brand {
      margin-bottom: var(--space-3);
    }
  }

  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-half);
  }

  /* One-line rows are 32px; links bleed 8px above and below for a 48px tap target. */
  .index-item,
  .index-link {
    display: grid;
    grid-template-columns: var(--space-5) 1fr auto;
    align-items: start;
    gap: var(--space-2);
    padding-block: var(--space-1);
  }

  .index-item {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .index-item:has(.index-link) {
    display: flow-root;
    padding-block: 0;
  }

  .index-item .num {
    color: rgba(82, 82, 91, 0.75);
    transition: color 0.2s ease;
  }

  .index-link {
    padding-block: var(--space-2);
    margin-block: calc(-1 * var(--space-1));
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .index-link:hover {
      color: var(--color-text);
    }

    .index-link:hover .num {
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-item,
    .index-item .num {
      transition: none;
    }
  }

  .index-item.current,
  .index-item.current .num {
    color: var(--color-accent);
    cursor: default;
  }

  .status-footer {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-mini);
    color: var(--color-muted);
    text-transform: uppercase;
  }
</style>
