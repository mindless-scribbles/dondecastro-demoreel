---
// Reel preview panel: video placeholder, play button with reel sub-buttons, metadata chips.
// In normal document flow; sizes from aspect-ratio, not viewport math.
// Reels play inside the panel (YouTube embed), never in a new tab. The links keep
// their YouTube hrefs so modifier-clicks and no-JS still work.

// Specs are the real reels: resolution from YouTube's top format, 23.98fps per Don
// (YouTube rounds it to 24), duration mm:ss. The meta chips show a reel's specs while
// its button is hovered or focused, and the summary otherwise (always, on touch).
const FPS = "23.98fps";
const reels = [
  { id: "_6fQY8wwXQs", label: "Tech Anim", res: "1080p", duration: "01:49" },
  { id: "4ca-ywgyVdE", label: "Mocap / Anim", res: "4K", duration: "01:54" },
];

const toSeconds = (mmss: string) => {
  const [m, s] = mmss.split(":").map(Number);
  return m * 60 + s;
};
const totalSeconds = reels.reduce((sum, r) => sum + toSeconds(r.duration), 0);
const total = `${String(Math.floor(totalSeconds / 60)).padStart(2, "0")}:${String(totalSeconds % 60).padStart(2, "0")}`;
const topRes = reels.some((r) => r.res === "4K") ? "4K" : reels[0].res;

const summary = { res: `Up to ${topRes} ${FPS}`, duration: `${reels.length} Reels / ${total}` };
---

<section class="reel-panel group" aria-label="Demo reel">
  <div class="video-placeholder" aria-hidden="true"></div>

  <div class="reel-center">
    <div class="play-actions">
      <button class="play-btn" type="button" aria-label="Play reel">
        <span class="play-label">Play Reel</span>
        <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </button>
      <div class="sub-actions">
        {
          reels.map((reel) => (
            <a
              class="sub-btn"
              href={`https://youtu.be/${reel.id}`}
              data-video-id={reel.id}
              data-title={reel.label}
              data-res={`${reel.res} ${FPS}`}
              data-duration={`Duration / ${reel.duration}`}
            >
              <span class="btn-fill" aria-hidden="true" />
              <span class="sub-label">{reel.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="meta" data-res={summary.res} data-duration={summary.duration}>
    <span class="chip">Res: <span class="meta-res">{summary.res}</span></span>
    <span class="chip meta-duration">{summary.duration}</span>
  </div>

  <!-- The panel itself becomes the player. -->
  <div class="inline-player" hidden>
    <div class="player-bar">
      <span class="chip now-playing">Now playing / <span class="now-title"></span></span>
      <button class="player-close" type="button" aria-label="Close reel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="player-frame"></div>
  </div>
</section>


<script>
  // ---------- Reel playback ----------
  const makeIframe = (id: string, title: string) => {
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
    iframe.title = `${title} demo reel`;
    iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    iframe.allowFullscreen = true;
    return iframe;
  };

  document.querySelectorAll<HTMLElement>(".reel-panel").forEach((panel) => {
    const inline = panel.querySelector<HTMLElement>(".inline-player");
    const inlineFrame = inline?.querySelector<HTMLElement>(".player-frame");
    let opener: HTMLElement | null = null;

    const closeInline = () => {
      if (!inline || !inlineFrame) return;
      inlineFrame.replaceChildren();
      inline.hidden = true;
      panel.classList.remove("is-playing");
      opener?.focus();
    };

    const play = (btn: HTMLElement) => {
      const id = btn.dataset.videoId;
      if (!id || !inline || !inlineFrame) return;
      opener = btn;
      const title = btn.dataset.title ?? "";
      const iframe = makeIframe(id, title);
      panel.querySelectorAll(".now-title").forEach((el) => (el.textContent = title));

      inlineFrame.replaceChildren(iframe);
      inline.hidden = false;
      panel.classList.add("is-playing");
      inline.querySelector<HTMLElement>(".player-close")?.focus({ preventScroll: true });
      // Lands --space-2 below the header (scroll-margin-top), which is where the panel
      // already sits at the top of the page, so there it doesn't move.
      panel.scrollIntoView({
        block: "start",
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      });
    };

    panel.querySelectorAll<HTMLAnchorElement>(".sub-btn[data-video-id]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        // Let Cmd/Ctrl/Shift/middle-click still open YouTube.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        play(btn);
      });
    });

    inline?.querySelector(".player-close")?.addEventListener("click", closeInline);
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.classList.contains("is-playing")) closeInline();
    });
  });

  // ---------- Meta chips follow the hovered / focused reel ----------
  document.querySelectorAll<HTMLElement>(".reel-panel").forEach((panel) => {
    const meta = panel.querySelector<HTMLElement>(".meta");
    const res = meta?.querySelector<HTMLElement>(".meta-res");
    const duration = meta?.querySelector<HTMLElement>(".meta-duration");
    const subActions = panel.querySelector<HTMLElement>(".sub-actions");
    if (!meta || !res || !duration || !subActions) return;

    const show = (source: HTMLElement) => {
      res.textContent = source.dataset.res ?? "";
      duration.textContent = source.dataset.duration ?? "";
    };

    subActions.querySelectorAll<HTMLElement>(".sub-btn").forEach((btn) => {
      btn.addEventListener("pointerenter", () => show(btn));
      btn.addEventListener("focus", () => show(btn));
    });
    subActions.addEventListener("pointerleave", () => {
      if (!subActions.contains(document.activeElement)) show(meta);
    });
    subActions.addEventListener("focusout", (e) => {
      if (!subActions.contains(e.relatedTarget as Node | null)) show(meta);
    });
  });

  // ---------- Sub-button fill ----------
  document.querySelectorAll<HTMLElement>(".play-actions").forEach((wrapper) => {
    const subActions = wrapper.querySelector<HTMLElement>(".sub-actions");
    const subBtns = Array.from(wrapper.querySelectorAll<HTMLElement>(".sub-btn"));
    let active: HTMLElement | null = null;

    const setFill = (btn: HTMLElement, origin: "left" | "right", scale: 0 | 1) => {
      btn.style.setProperty("--fill-origin", origin);
      btn.style.setProperty("--fill-scale", String(scale));
    };

    subBtns.forEach((btn) => {
      btn.addEventListener("pointerenter", () => {
        if (active && active !== btn) {
          const movingRight =
            btn.getBoundingClientRect().left > active.getBoundingClientRect().left;
          if (movingRight) {
            setFill(active, "right", 0);
            setFill(btn, "left", 1);
          } else {
            setFill(active, "left", 0);
            setFill(btn, "right", 1);
          }
        } else if (!active) {
          setFill(btn, "left", 1);
        }
        active = btn;
      });
    });

    subActions?.addEventListener("pointerleave", () => {
      if (active) {
        setFill(active, "left", 0);
        active = null;
      }
    });
  });
</script>

<style>
  /* The reel panel keeps the orange focus ring (the site default is off-white). */
  .reel-panel :focus-visible {
    outline-color: var(--color-accent);
  }

  .reel-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, rgba(7, 7, 9, 0) 0%, rgba(7, 7, 9, 1) 100%);
  }

  @media (min-width: 768px) {
    .reel-panel {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .reel-panel {
      aspect-ratio: 16 / 7;
    }
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    background: url("https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=1280")
      center / cover;
    filter: grayscale(1) contrast(1.2) brightness(0.6);
    transition: transform 0.7s ease;
  }

  @media (hover: hover) {
    .reel-panel:hover .video-placeholder {
      transform: scale(1.05);
    }
  }

  .reel-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
  }

  .play-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .play-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: rgba(7, 7, 9, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .play-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
  }

  .play-icon {
    width: var(--space-2);
    height: var(--space-2);
    fill: currentColor;
  }

  /* Sub-buttons: revealed on hover where hover exists, always shown on touch. */
  .sub-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  @media (hover: hover) {
    .play-btn:hover {
      border-color: var(--color-accent);
    }

    .sub-actions {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .play-actions:hover .sub-actions,
    .play-actions:focus-within .sub-actions {
      opacity: 1;
      visibility: visible;
    }
  }

  .sub-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: rgba(7, 7, 9, 0.4);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.3s ease;
  }

  @media (hover: hover) {
    .sub-btn:hover {
      border-color: var(--color-accent);
    }
  }

  .sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
  }

  .btn-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    z-index: -1;
    transform: scaleX(var(--fill-scale, 0));
    transform-origin: var(--fill-origin, left);
    transition: transform 0.3s ease;
  }

  .meta {
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .chip {
    padding: var(--space-half) var(--space-1);
    border-radius: var(--radius-sm);
    background: rgba(7, 7, 9, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    text-transform: uppercase;
    color: rgba(161, 161, 170, 0.9);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    .meta {
      left: var(--space-3);
      right: var(--space-3);
      bottom: var(--space-3);
    }
  }

  /* ---------- Player (shared) ---------- */
  .player-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .player-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Bar above the video: title chip + close. Kept off the video so it never covers YouTube's controls. */
  .player-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .player-close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: rgba(7, 7, 9, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .player-close svg {
    width: var(--space-2);
    height: var(--space-2);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  @media (hover: hover) {
    .player-close:hover {
      border-color: var(--color-accent);
    }
  }

  /* ---------- Playing ---------- */
  /* While playing, the panel sizes to bar + 16:9 video at every width. */
  .reel-panel.is-playing {
    aspect-ratio: auto;
    /* Never taller than the space under the sticky header (with a --space-2 gap above
       and below): cap the width from the height. */
    max-width: min(
      100%,
      (100dvh - var(--header-height) - 2 * var(--space-2) - var(--touch-target) - 3 * var(--space-1)) * 16 / 9 +
        2 * var(--space-1)
    );
    margin-inline: auto;
    padding: var(--space-1);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--header-height) + var(--space-2));
  }

  .reel-panel.is-playing > :not(.inline-player) {
    display: none;
  }

  .inline-player[hidden] {
    display: none;
  }

  .inline-player .player-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  @media (prefers-reduced-motion: reduce) {
    .player-close {
      transition: none;
    }
  }
</style>

