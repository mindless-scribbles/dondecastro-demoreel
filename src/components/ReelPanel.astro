---
// Reel preview panel: video placeholder, play button with reel sub-buttons, metadata chips.
// In normal document flow; sizes from aspect-ratio, not viewport math.
---

<section class="reel-panel group" aria-label="Demo reel">
  <div class="video-placeholder" aria-hidden="true"></div>

  <div class="reel-center">
    <div class="play-actions">
      <button class="play-btn" type="button" aria-label="Play reel">
        <span class="play-label">Play Reel</span>
        <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </button>
      <div class="sub-actions">
        <a class="sub-btn" href="https://youtu.be/_6fQY8wwXQs" target="_blank" rel="noopener noreferrer">
          <span class="btn-fill" aria-hidden="true"></span>
          <span class="sub-label">Tech Anim</span>
        </a>
        <a class="sub-btn" href="https://youtu.be/4ca-ywgyVdE" target="_blank" rel="noopener noreferrer">
          <span class="btn-fill" aria-hidden="true"></span>
          <span class="sub-label">Mocap / Anim</span>
        </a>
      </div>
    </div>
  </div>

  <div class="meta">
    <div class="chips">
      <span class="chip">Res: 4K 23.98fps</span>
      <span class="chip chip-optional">Codec: RAW.001</span>
      <span class="chip rec">Rec ●</span>
    </div>
    <span class="chip">Duration / 01:42</span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".play-actions").forEach((wrapper) => {
    const subActions = wrapper.querySelector<HTMLElement>(".sub-actions");
    const subBtns = Array.from(wrapper.querySelectorAll<HTMLElement>(".sub-btn"));
    let active: HTMLElement | null = null;

    const setFill = (btn: HTMLElement, origin: "left" | "right", scale: 0 | 1) => {
      btn.style.setProperty("--fill-origin", origin);
      btn.style.setProperty("--fill-scale", String(scale));
    };

    subBtns.forEach((btn) => {
      btn.addEventListener("pointerenter", () => {
        if (active && active !== btn) {
          const movingRight =
            btn.getBoundingClientRect().left > active.getBoundingClientRect().left;
          if (movingRight) {
            setFill(active, "right", 0);
            setFill(btn, "left", 1);
          } else {
            setFill(active, "left", 0);
            setFill(btn, "right", 1);
          }
        } else if (!active) {
          setFill(btn, "left", 1);
        }
        active = btn;
      });
    });

    subActions?.addEventListener("pointerleave", () => {
      if (active) {
        setFill(active, "left", 0);
        active = null;
      }
    });
  });
</script>

<style>
  .reel-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, rgba(7, 7, 9, 0) 0%, rgba(7, 7, 9, 1) 100%);
  }

  @media (min-width: 768px) {
    .reel-panel {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .reel-panel {
      aspect-ratio: 16 / 7;
    }
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    background: url("https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=1280")
      center / cover;
    filter: grayscale(1) contrast(1.2) brightness(0.6);
    transition: transform 0.7s ease;
  }

  @media (hover: hover) {
    .reel-panel:hover .video-placeholder {
      transform: scale(1.05);
    }
  }

  .reel-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
  }

  .play-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .play-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: rgba(7, 7, 9, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .play-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
  }

  .play-icon {
    width: var(--space-2);
    height: var(--space-2);
    fill: currentColor;
  }

  /* Sub-buttons: revealed on hover where hover exists, always shown on touch. */
  .sub-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  @media (hover: hover) {
    .play-btn:hover {
      border-color: var(--color-accent);
    }

    .sub-actions {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .play-actions:hover .sub-actions,
    .play-actions:focus-within .sub-actions {
      opacity: 1;
      visibility: visible;
    }
  }

  .sub-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: rgba(7, 7, 9, 0.4);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.3s ease;
  }

  @media (hover: hover) {
    .sub-btn:hover {
      border-color: var(--color-accent);
    }
  }

  .sub-label {
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
  }

  .btn-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    z-index: -1;
    transform: scaleX(var(--fill-scale, 0));
    transform-origin: var(--fill-origin, left);
    transition: transform 0.3s ease;
  }

  .meta {
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-2);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .chip {
    padding: var(--space-half) var(--space-1);
    border-radius: var(--radius-sm);
    background: rgba(7, 7, 9, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    text-transform: uppercase;
    color: rgba(161, 161, 170, 0.9);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rec {
    color: var(--color-accent);
    animation: pulse-rec 1.6s ease-in-out infinite;
  }

  @keyframes pulse-rec {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (max-width: 767px) {
    .chip-optional {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .meta {
      left: var(--space-3);
      right: var(--space-3);
      bottom: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec {
      animation: none;
    }
  }
</style>
