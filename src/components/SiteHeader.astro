---
interface Props {
  navItems?: { label: string; href: string }[];
  sticky?: boolean;
}

const defaultNav = [
  { label: "Expertise", href: "/expertise" },
  { label: "Journal", href: "/#journal" },
  { label: "Contact", href: "/contact" },
];

const { navItems = defaultNav, sticky = false } = Astro.props;
const hasMiddle = Astro.slots.has("middle");
---

<header
  class:list={[
    "site-header grid grid-cols-[1fr_auto_1fr] items-start w-full relative z-30",
    { sticky: sticky },
  ]}
>
  <a href="/" class="brand col-start-1 justify-self-start" aria-label="MS — Creative Agency, home">
    <span class="brand-letters">
      <span class="brand-m">M</span>
      <span class="brand-s">S</span>
    </span>
    <span class="brand-sub">Creative Agency</span>
  </a>

  {
    hasMiddle && (
      <div class="middle col-start-2 justify-self-center">
        <slot name="middle" />
      </div>
    )
  }

  <nav class="nav col-start-3 justify-self-end">
    {
      navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    padding: var(--space-2) var(--page-margin);
  }

  .site-header.sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    align-items: center;
    background-color: rgba(7, 7, 9, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .middle {
    align-self: center;
  }

  .brand {
    color: rgba(82, 82, 91, 0.8);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }

  .brand-letters {
    display: flex;
    align-items: baseline;
    line-height: 1;
  }

  .brand-m {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: rgba(82, 82, 91, 0.8);
  }

  .brand-s {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(82, 82, 91, 0.8);
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    color: rgba(255, 51, 0, 0.55);
    margin-top: -2px;
  }

  .nav {
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    text-align: right;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .nav-link:hover {
      color: rgba(255, 51, 0, 0.55);
    }
  }

  /* Touch: 48px tap targets, nav stays in a row. */
  @media (hover: none) {
    .nav-link {
      min-height: var(--touch-target);
    }

    .site-header {
      padding-block: var(--space-1);
    }
  }

  @media (min-width: 768px) {
    .brand-m {
      font-size: 32px;
    }

    .brand-s {
      font-size: 36px;
    }

    .brand-sub {
      font-size: 10px;
    }

    .nav-link {
      font-size: var(--text-mini);
    }
  }

  /* Pointer devices from 768 up keep the original stacked, right-aligned nav. */
  @media (min-width: 768px) and (hover: hover) {
    .nav {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
