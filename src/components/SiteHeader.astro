---
interface Props {
  navItems?: { label: string; href: string }[];
  sticky?: boolean;
  /** Home: the brand starts faint and turns white as the hero name scrolls away. */
  fadeBrand?: boolean;
}

const defaultNav = [
  { label: "Expertise", href: "/expertise" },
  { label: "Journal", href: "/#journal" },
  { label: "Contact", href: "/contact" },
];

const { navItems = defaultNav, sticky = false, fadeBrand = false } = Astro.props;
const hasMiddle = Astro.slots.has("middle");
---

<header
  class:list={[
    "site-header grid grid-cols-[1fr_auto_1fr] items-start w-full relative z-30",
    { sticky: sticky },
  ]}
  data-fade-brand={fadeBrand ? "" : undefined}
>
  <a href="/" class="brand col-start-1 justify-self-start" aria-label="Don De Castro, home">Don De&nbsp;Castro</a>

  {
    hasMiddle && (
      <div class="middle col-start-2 justify-self-center">
        <slot name="middle" />
      </div>
    )
  }

  <nav class="nav col-start-3 justify-self-end" aria-label="Main">
    {
      navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    padding: var(--space-2) var(--page-margin);
  }

  .site-header.sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    align-items: center;
    background-color: rgba(7, 7, 9, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .middle {
    align-self: center;
  }

  .brand {
    align-self: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-label);
    line-height: var(--leading-label);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    /* --brand-alpha is set by the fade script on the home page; 1 without JS. */
    color: rgba(244, 244, 245, calc(0.2 + 0.8 * var(--brand-alpha, 1)));
  }

  .nav {
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    text-align: right;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .nav-link:hover {
      color: var(--color-hover);
    }
  }

  /* Touch: 48px tap targets, nav stays in a row. */
  @media (hover: none) {
    .nav-link {
      min-height: var(--touch-target);
    }

    .site-header {
      padding-block: var(--space-1);
    }
  }

  /* Pointer devices from 768: title size. Touch keeps 14px so it sits beside the nav row. */
  @media (min-width: 768px) and (hover: hover) {
    .brand {
      font-size: var(--text-title);
      line-height: var(--leading-title);
    }
  }

  @media (min-width: 768px) {
    .nav-link {
      font-size: var(--text-mini);
    }
  }

  /* Pointer devices from 768 up keep the original stacked, right-aligned nav. */
  @media (min-width: 768px) and (hover: hover) {
    .nav {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>

<script>
  // Home: fade the brand from 20% to full white as the hero name scrolls under the header.
  const header = document.querySelector<HTMLElement>("[data-fade-brand]");
  const heroTitle = document.querySelector<HTMLElement>(".hero-title");

  if (header && heroTitle) {
    let queued = false;

    const update = () => {
      queued = false;
      // Scroll distance at which the hero title's bottom reaches the header's bottom.
      const end = heroTitle.getBoundingClientRect().bottom + window.scrollY - header.offsetHeight;
      const progress = end > 0 ? Math.min(Math.max(window.scrollY / end, 0), 1) : 1;
      header.style.setProperty("--brand-alpha", progress.toFixed(3));
    };

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
  }
</script>
