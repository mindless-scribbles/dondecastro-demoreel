---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter, title, description } = Astro.props;
const pageTitle = frontmatter?.title ?? title;
const pageDescription = frontmatter?.description ?? description;

const expertiseNav = [
  { label: "Home", href: "/" },
  { label: "Journal", href: "/#journal" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="md-root relative z-10">
    <SiteHeader sticky navItems={expertiseNav} />
    <main class="page-container md-page">
      <div class="md-surface">
        <div class="download-btn-wrap">
          <a class="download-btn" href="/DonDeCastro-Resume.pdf" download>
            <span class="btn-fill" aria-hidden="true"></span>
            <svg class="download-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            <span class="download-label">Download Resume</span>
          </a>
        </div>
        <article class="prose">
          <slot />
        </article>
      </div>
    </main>
  </div>
</BaseLayout>


<style>
  .md-root {
    min-height: 100vh;
  }

  .md-page {
    padding-block: var(--space-4) var(--space-12);
  }

  /* From 768 up the prose sits on a rounded surface card; phone stays open for width. */
  @media (min-width: 768px) {
    .md-surface {
      max-width: calc(68ch + 2 * var(--space-6));
      margin-inline: auto;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
    }
  }

  .download-btn-wrap {
    max-width: 68ch;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
  }

  /* Canonical button (STYLE_GUIDE §5): scaleX fill, not width. */
  .download-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
    text-decoration: none;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  /* Off-white fill; the label flips to the background color while filled. */
  .btn-fill {
    position: absolute;
    inset: 0;
    background: var(--color-text);
    z-index: -1;
    transform: scaleX(var(--fill-scale, 0));
    transform-origin: var(--fill-origin, left);
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .download-btn:hover {
      --fill-scale: 1;
      border-color: var(--color-text);
      color: var(--color-bg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-btn,
    .btn-fill {
      transition: none;
    }
  }

  .download-icon {
    width: var(--space-2);
    height: var(--space-2);
  }

  .prose {
    max-width: 68ch;
    margin: 0 auto;
    padding-top: var(--space-4);
  }

  .prose :global(h1) {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(var(--text-heading), 5vw, var(--space-6));
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: 0.05em;
    margin: var(--space-6) 0 var(--space-2);
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mini);
    margin: var(--space-4) 0 var(--space-half);
    color: var(--color-text);
  }

  .prose :global(p) {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin: 0 0 var(--space-2);
    color: rgba(244, 244, 245, 0.85);
  }

  .prose :global(a) {
    color: rgba(82, 82, 91, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .prose :global(a:hover) {
      color: var(--color-hover);
    }
  }

  .prose :global(ul) {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-3);
    list-style: none;
  }

  .prose :global(li) {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin: 0 0 var(--space-1);
    color: rgba(244, 244, 245, 0.85);
    position: relative;
  }

  .prose :global(li::before) {
    content: "›";
    position: absolute;
    left: calc(-1 * var(--space-3));
    color: var(--color-muted);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) 0;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .prose :global(em) {
    font-style: italic;
    color: rgba(244, 244, 245, 0.9);
  }
</style>
