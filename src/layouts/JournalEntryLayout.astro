---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Expertise", href: "/expertise" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout title={title} description={description}>
  <div class="journal-entry-root relative z-10">
    <SiteHeader navItems={navItems} sticky />

    <main class="entry-main">
      <slot />
    </main>
  </div>
</BaseLayout>

<!-- Article and caption bodies are Markdown (src/content/journal), so these can't be scoped. -->
<style is:global>
  .journal-entry-root .prose {
    font-family: var(--font-body);
    font-size: var(--text-read);
    line-height: var(--leading-read);
    color: var(--color-text);
  }

  .journal-entry-root .prose p {
    margin: 0 0 1.2em;
  }

  .journal-entry-root .prose > :last-child {
    margin-bottom: 0;
  }

  .journal-entry-root .prose h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-read-heading);
    line-height: 1.3;
  }

  .journal-entry-root .prose a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .journal-entry-root .prose a:hover {
      color: var(--color-hover);
    }
  }

  .journal-entry-root .prose blockquote {
    margin: var(--space-6) 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

  .journal-entry-root .prose blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title);
    line-height: var(--leading-title);
  }

  @media (min-width: 768px) {
    .journal-entry-root .prose blockquote {
      margin-block: var(--space-8);
    }

    .journal-entry-root .prose blockquote p {
      font-size: var(--text-quote);
      line-height: var(--leading-heading);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-entry-root .prose a {
      transition: none;
    }
  }
</style>

<style>
  .journal-entry-root {
    min-height: 100vh;
  }
</style>
