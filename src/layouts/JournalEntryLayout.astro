---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import FieldLogsSidebar from "../components/FieldLogsSidebar.astro";

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
}

const { title, description, currentSlug } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Expertise", href: "/expertise" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout title={title} description={description}>
  <div class="journal-entry-root relative z-10">
    <SiteHeader navItems={navItems} sticky />

    <div class="entry-shell">
      <FieldLogsSidebar currentSlug={currentSlug} />

      <main class="entry-main">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .journal-entry-root .entry-main .article-container p {
    margin: 0 0 var(--space-4);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: var(--leading-body);
    color: rgba(244, 244, 245, 0.85);
    text-align: justify;
  }

  /* Article body is Markdown (src/content/journal), so these can't be scoped. */
  .journal-entry-root .content-body > p:first-of-type::first-letter {
    font-family: var(--font-serif);
    float: left;
    font-size: var(--space-10);
    line-height: var(--space-10);
    margin-right: var(--space-2);
    color: var(--color-accent);
  }

  .journal-entry-root .content-body a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .journal-entry-root .content-body a:hover {
      color: rgba(255, 51, 0, 0.55);
    }
  }

  .journal-entry-root .content-body blockquote {
    margin: var(--space-6) 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
  }

  .journal-entry-root .entry-main .article-container blockquote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-style: italic;
    line-height: var(--leading-title);
    text-align: left;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .journal-entry-root .content-body blockquote {
      margin-block: var(--space-8);
      padding-left: var(--space-4);
    }

    .journal-entry-root .entry-main .article-container blockquote p {
      font-size: var(--text-heading);
      line-height: var(--leading-heading);
    }
  }

  .journal-entry-root .inline-metadata {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-1);
    margin: 0 var(--space-half);
    vertical-align: middle;
    transform: translateY(-1px);
    font-family: var(--font-mono);
  }
</style>

<style>
  .journal-entry-root {
    min-height: 100vh;
  }

  .entry-shell {
    display: grid;
    /* 320 = 40 × 8 */
    grid-template-columns: 320px 1fr;
    min-height: calc(100vh - var(--header-height));
    align-items: start;
  }

  .entry-main {
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .entry-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
