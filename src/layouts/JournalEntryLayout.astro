---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import FieldLogsSidebar from "../components/FieldLogsSidebar.astro";

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
}

const { title, description, currentSlug } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="journal-entry-root relative z-10">
    <SiteHeader sticky />

    <div class="entry-shell">
      <FieldLogsSidebar currentSlug={currentSlug} />

      <main class="entry-main">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style is:global>
  body:has(.journal-entry-root) .frame {
    display: none;
  }

  .journal-entry-root .entry-main .article-container p {
    margin: 0 0 var(--space-4);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: var(--leading-body);
    color: rgba(244, 244, 245, 0.85);
    text-align: justify;
  }

  .journal-entry-root .dropcap {
    font-family: var(--font-serif);
    float: left;
    font-size: var(--space-10);
    line-height: var(--space-10);
    margin-right: var(--space-2);
    color: var(--color-accent);
  }

  .journal-entry-root .inline-metadata {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--text-mini);
    line-height: var(--leading-mini);
    letter-spacing: var(--tracking-label);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-1);
    margin: 0 var(--space-half);
    vertical-align: middle;
    transform: translateY(-1px);
    font-family: var(--font-mono);
  }
</style>

<style>
  .journal-entry-root {
    min-height: 100vh;
  }

  .entry-shell {
    display: grid;
    /* 320 = 40 × 8 */
    grid-template-columns: 320px 1fr;
    min-height: calc(100vh - var(--header-height));
    align-items: start;
  }

  .entry-main {
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .entry-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
